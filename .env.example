# Copy to .env, then use your local PostgreSQL role and password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ridesync_team10
PGUSER=postgres
PGPASSWORD=
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ridesync_team10

# Small development dataset. Increase for the required scale verification.
NUM_RIDERS=100
NUM_VEHICLES=40
NUM_TRIPS=100
NUM_PINGS=1000
TTL_WINDOW_SECONDS=1800
BATCH_SIZE=500
ORIGIN_LONGITUDE=78.4867
ORIGIN_LATITUDE=17.3850

# Admin sign-in. Leave ADMIN_PASSWORD empty to switch admin login off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: a long random string so admin sessions survive API restarts.
ADMIN_SESSION_SECRET=
